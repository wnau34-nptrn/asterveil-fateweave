{
  "name": "asterveil-fateweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --base=/asterveil-fateweave/",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "sim": "SIM_REPORT=1 vitest run tests/campaign-sim.test.ts tests/starter-sim.test.ts tests/balance-sim.test.ts tests/class-sim.test.ts tests/formation-sim.test.ts tests/tree-sim.test.ts tests/character-sim.test.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
